<?xml version="1.0" encoding="utf-8"?>
<!-- Background for the pre-connection setup screens: the artwork plus a
     translucent white overlay so the dark text on the cards stays readable. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:src="@drawable/setup_background_image"
            android:gravity="fill" />
    </item>
    <item>
        <shape>
            <solid android:color="#99FFFFFF" />
        </shape>
    </item>
</layer-list>
